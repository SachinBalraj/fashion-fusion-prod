# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/fashion-fusion

# JWT
JWT_SECRET=your_jwt_secret_here

# Client URL
CLIENT_URL=http://localhost:5173

# Admin bootstrap (used by scripts/seedAdmin.js and scripts/resetAdminPassword.js)
# KEEP THESE OUT OF SOURCE CONTROL in the hosting platform only.
# Password must NEVER be committed here or anywhere in the repo.
ADMIN_EMAIL=admin@fashionsfusion.com
# ADMIN_PASSWORD=

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password

# Product images are stored in MongoDB Atlas GridFS (bucket: productImages).
# No Cloudinary configuration is required.
